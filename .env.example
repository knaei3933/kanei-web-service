MAIL_PROVIDER=smtp
MAIL_FROM=info@kanei-trade.co.jp
MAIL_REPLY_TO=info@kanei-trade.co.jp
MAIL_INTERNAL_TO=info@kanei-trade.co.jp
SMTP_HOST=sv12515.xserver.jp
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@kanei-trade.co.jp
SMTP_PASS=__SET_IN_VERCEL_ONLY__

# --- SMTP リレーフォールバック（任意・本番で SMTP 拒否時のセーフティネット）---
# Vercel から直接 SMTP 送信すると 554 client host rejected 等で拒否される場合、
# 社内 WSL のリレーサーバー（kanei_mail_relay.py）経由で代理送信する。
# 未設定なら SMTP のエラーをそのまま返す（log プロバイダ挙動は維持される）。
#
# 構成は二段:
#   アプリ内 Relay プロバイダ → MAIL_RELAY_URL（固定の公開ルート）
#   → /api/mail-relay が MAIL_RELAY_UPSTREAM_URL（WSL トンネル等）へ転送
#
# 1) 固定の公開リレールート（Vercel 上の安定エンドポイント）
#    アプリはここへ JSON を POST する。URL は変更不要。
# MAIL_RELAY_URL=https://kanei-web-service.vercel.app/api/mail-relay
#
# 2) 上流リレーのエンドポイント（/api/mail-relay が転送する先）
#    現行の WSL トンネル URL、または将来の固定上流を指定する。
#    トンネル URL が変わった場合はここだけ差し替える。
# MAIL_RELAY_UPSTREAM_URL=https://relay.example.com/mail
#
# 3) リレー認証用の共有シークレット
#    /api/mail-relay の認証と、上流 WSL リレー（RELAY_SECRET）で同じ値を使う。
# MAIL_RELAY_SECRET=__SET_IN_VERCEL_ONLY__

# --- 相談成果物ストレージリレー（任意・本番で /tmp 恒久保存用）---
# Vercel/serverless では /tmp がインスタンス単位・エフェメラルで、別リクエストで
# 書いた承認パッケージ等が読めず、review/approve/plan-approve が壊れる。
# 成果物（submission/brief/approval-package/omc-plan/execution-handoff/execution-prompt）
# を社内 WSL のリレーストレージへ HTTP 経由で恒久保存する。
# ※ 顧客アップロードの添付ファイル本体（画像・PDF 等・バイナリ）も同じアダプタ経由で
#    {submissionId}/files/{savedName} として恒久保存される。
#    添付の「メタデータ」も引き続き submission.json / approval-package.json に保持される。
#
# 構成は二段（mail-relay と同じ）:
#   アダプタ（Relay プロバイダ）→ SUBMISSION_STORAGE_RELAY_URL（固定の公開ルート）
#   → /api/submission-storage が SUBMISSION_STORAGE_RELAY_UPSTREAM_URL（WSL 等）へ転送
#
# 1) 固定の公開ストレージルート（Vercel 上の安定エンドポイント）
#    アダプタはここへ PUT/GET する。URL は変更不要。
# SUBMISSION_STORAGE_RELAY_URL=https://kanei-web-service.vercel.app/api/submission-storage
#
# 2) 上流ストレージのベース URL（/api/submission-storage が転送する先）
#    {UPSTREAM}/{submissionId}/{fileName} の形で GET/PUT/DELETE を受け付けること。
# SUBMISSION_STORAGE_RELAY_UPSTREAM_URL=https://storage.example.com/submissions
#
# 3) ストレージリレー認証用の共有シークレット
#    /api/submission-storage の認証と上流ストレージで同じ値を使う。
# SUBMISSION_STORAGE_RELAY_SECRET=__SET_IN_VERCEL_ONLY__

